# 将本文件复制为 gateway.env，维护以下配置。
# 影像地址由工作流拼接。相对路径任务会收到下面已填写的影像配置。
# 填写 Postman 调用成功的 HiAgent 同步工作流完整 URL，包含端口和全部路径。
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=<published-workflow-api-key>

# 相对路径使用此下载基础地址和 AU，实际 gateway.env 已从参考项目复制。
# 模板中的 AU 留空，正式配置使用现场值。
IMAGE_PLATFORM_DOWNLOAD_BASE_URL=
IMAGE_PLATFORM_AU=

# CP 回调接口的完整 URL。
CALLBACK_URL=http://10.240.184.200:9090/NLSC/LdsAiTaskESBFunctionApi/0.1.0/ldaAiTaskResultCallback

